{
  "schema_version": 1,
  "kind": "asset_type",
  "id": "base.list",
  "renderer": "core.text-group",
  "source_kinds": ["agent-generated"],
  "capabilities": [
    "visual",
    "text.items",
    "ordered-items",
    "text.style",
    "layout.flow",
    "transform.scale",
    "style.opacity"
  ],
  "default_layer": 400,
  "defaults": {
    "enabled": true,
    "source": { "kind": "agent-generated" },
    "props": {
      "box": { "x": 0.08, "y": 0.12, "width": 0.84, "height": 0.3, "unit": "ratio" },
      "style": {
        "font_family": "Microsoft YaHei",
        "font_size_ratio": 0.045,
        "color": "#FFFFFF",
        "stroke_color": "#000000",
        "stroke_width_ratio": 0.004,
        "item_gap_ratio": 0.014,
        "align": "left"
      },
      "items": []
    }
  },
  "instance_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["items"],
    "properties": {
      "box": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y", "width", "height"],
        "properties": {
          "x": { "type": "number", "minimum": 0, "maximum": 1 },
          "y": { "type": "number", "minimum": 0, "maximum": 1 },
          "width": { "type": "number", "minimum": 0.05, "maximum": 1 },
          "height": { "type": "number", "minimum": 0.05, "maximum": 1 },
          "unit": { "const": "ratio" }
        }
      },
      "style": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "font_family": { "enum": ["Microsoft YaHei", "华文中宋"] },
          "font_size_ratio": { "type": "number", "minimum": 0.015, "maximum": 0.12 },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "stroke_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "stroke_width_ratio": { "type": "number", "minimum": 0, "maximum": 0.03 },
          "item_gap_ratio": { "type": "number", "minimum": 0, "maximum": 0.08 },
          "align": { "const": "left" }
        }
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_word_index", "end_word_index"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "start_word_index": { "type": "integer", "minimum": 0 },
            "end_word_index": { "type": "integer", "minimum": 0 },
            "display_text": { "type": "string", "maxLength": 120 }
          }
        }
      }
    }
  },
  "ui": {
    "label": "清单",
    "selectable": true,
    "create_from_selection": true,
    "create_label": "新建清单",
    "default_effects": [
      {
        "type": "base.progressive-reveal",
        "timing": { "kind": "asset_items" },
        "config": { "retain_until": "asset_end" }
      }
    ]
  }
}

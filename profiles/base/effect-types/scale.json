{
  "schema_version": 1,
  "kind": "effect_type",
  "id": "base.scale",
  "operator": "core.transform.scale",
  "requires_capabilities": ["transform.scale"],
  "timing_models": ["word_range"],
  "writes_channels": ["transform.scale"],
  "overlap_policy": "exclusive-per-channel",
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["from_scale", "to_scale", "interpolation", "underflow_fill"],
    "properties": {
      "from_scale": { "type": "number", "exclusiveMinimum": 0 },
      "to_scale": { "type": "number", "exclusiveMinimum": 0 },
      "interpolation": { "enum": ["step", "linear"] },
      "underflow_fill": { "enum": ["black"] }
    }
  },
  "ui": {
    "label": "画面缩放",
    "preferred_target_source": "input.video",
    "presets": [
      {
        "id": "emphasis-step",
        "label": "短促重点",
        "className": "scale-button--in",
        "config": {
          "from_scale": 1,
          "to_scale": 1.2,
          "interpolation": "step",
          "underflow_fill": "black"
        }
      },
      {
        "id": "negative-step",
        "label": "短促负面",
        "className": "scale-button--out",
        "config": {
          "from_scale": 1,
          "to_scale": 0.75,
          "interpolation": "step",
          "underflow_fill": "black"
        }
      },
      {
        "id": "emphasis-linear",
        "label": "长重点",
        "className": "scale-button--in scale-button--long",
        "config": {
          "from_scale": 1,
          "to_scale": 1.2,
          "interpolation": "linear",
          "underflow_fill": "black"
        }
      },
      {
        "id": "negative-linear",
        "label": "长负面",
        "className": "scale-button--out scale-button--long",
        "config": {
          "from_scale": 1,
          "to_scale": 0.75,
          "interpolation": "linear",
          "underflow_fill": "black"
        }
      }
    ]
  }
}

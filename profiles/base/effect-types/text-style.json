{
  "schema_version": 1,
  "kind": "effect_type",
  "id": "base.text-style",
  "operator": "core.style.text",
  "requires_capabilities": ["text.style"],
  "timing_models": ["word_range", "cue", "item"],
  "writes_channels": ["style.font-scale", "style.color"],
  "overlap_policy": "exclusive-per-channel",
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["font_scale", "color"],
    "properties": {
      "font_scale": { "type": "number", "exclusiveMinimum": 0 },
      "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
    }
  },
  "ui": {
    "label": "文字样式",
    "preferred_target_source": "input.captions",
    "presets": [
      {
        "id": "emphasis-bright",
        "label": "大字号、亮黄色",
        "className": "scale-button--caption",
        "config": {
          "font_scale": 1.25,
          "color": "#FFF08A"
        }
      }
    ]
  }
}

{
  "schema_version": 1,
  "kind": "asset_type",
  "id": "base.captions",
  "renderer": "core.captions",
  "source_kinds": ["input.captions"],
  "capabilities": ["visual", "text.cues", "text.style", "layout.box"],
  "uses_primitives": [
    "base.layout.box",
    "base.typography.font-family",
    "base.typography.font-size",
    "base.typography.font-scale",
    "base.typography.color",
    "base.typography.stroke-color",
    "base.typography.stroke-width"
  ],
  "default_layer": 300,
  "system_instance": {
    "id": "captions.main",
    "enabled": false,
    "source": { "input": "captions" },
    "lifecycle": { "kind": "full" },
    "props": {}
  },
  "defaults": {
    "props": {
      "box": { "x": 0.06, "y": 0.7, "width": 0.88, "height": 0.2, "unit": "ratio" },
      "style": {
        "font_family": "Microsoft YaHei",
        "font_size_ratio": 0.06,
        "color": "#FFFFFF",
        "stroke_color": "#000000",
        "stroke_width_ratio": 0.0055,
        "align": "center"
      },
      "cue_overrides": {}
    }
  },
  "instance_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "box": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y", "width", "height"],
        "properties": {
          "x": { "type": "number", "minimum": 0, "maximum": 1 },
          "y": { "type": "number", "minimum": 0, "maximum": 1 },
          "width": { "type": "number", "minimum": 0.05, "maximum": 1 },
          "height": { "type": "number", "minimum": 0.05, "maximum": 1 },
          "unit": { "const": "ratio" }
        }
      },
      "style": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "font_family": { "enum": ["Microsoft YaHei", "华文中宋"] },
          "font_size_ratio": { "type": "number", "minimum": 0.015, "maximum": 0.15 },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "stroke_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "stroke_width_ratio": { "type": "number", "minimum": 0, "maximum": 0.03 },
          "align": { "const": "center" }
        }
      },
      "cue_overrides": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "font_family": { "enum": ["Microsoft YaHei", "华文中宋"] },
            "font_size_ratio": { "type": "number", "minimum": 0.015, "maximum": 0.15 }
          }
        }
      }
    }
  },
  "ui": { "label": "普通字幕", "selectable": true, "toggleable": true }
}

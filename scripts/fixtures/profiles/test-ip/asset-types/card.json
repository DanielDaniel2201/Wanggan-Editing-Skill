{
  "schema_version": 1,
  "kind": "asset_type",
  "id": "test-ip.card",
  "renderer": "core.text-group",
  "source_kinds": ["agent-generated"],
  "capabilities": [
    "visual", "text.items", "text.style", "layout.box", "layout.flow",
    "container.style", "style.opacity"
  ],
  "uses_primitives": [
    "base.layout.box",
    "base.layout.flow",
    "base.layout.gap",
    "base.layout.padding",
    "base.visual.opacity",
    "base.typography.font-family",
    "base.typography.font-size",
    "base.typography.color",
    "base.typography.stroke-color",
    "base.typography.stroke-width",
    "base.container.background-color",
    "base.container.background-opacity",
    "base.container.border-color",
    "base.container.border-opacity",
    "base.container.border-width",
    "base.container.border-radius"
  ],
  "default_layer": 420,
  "defaults": {
    "enabled": true,
    "source": { "kind": "agent-generated" },
    "props": {
      "box": { "x": 0.1, "y": 0.16, "width": 0.8, "height": 0.24, "unit": "ratio" },
      "container": {
        "background_color": "#101828",
        "background_opacity": 0.9,
        "border_color": "#FFFFFF",
        "border_opacity": 0.2,
        "border_width_ratio": 0.001,
        "border_radius_ratio": 0.012,
        "padding_ratio": 0.018
      },
      "style": {
        "font_family": "Microsoft YaHei",
        "font_size_ratio": 0.05,
        "color": "#FFFFFF",
        "stroke_color": "#000000",
        "stroke_width_ratio": 0.003,
        "item_gap_ratio": 0.008,
        "align": "left"
      },
      "items": []
    }
  },
  "instance_schema": {
    "type": "object",
    "additionalProperties": true,
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["start_word_index", "end_word_index", "display_text"],
          "properties": {
            "start_word_index": { "type": "integer", "minimum": 0 },
            "end_word_index": { "type": "integer", "minimum": 0 },
            "display_text": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "ui": { "label": "测试观点卡", "selectable": true }
}
